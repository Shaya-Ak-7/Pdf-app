{
  "name": "Pdf-app APK builder",
  "image": "mcr.microsoft.com/devcontainers/java:17",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "postCreateCommand": "bash scripts/codespace-build-apk.sh 2>&1 | tee /tmp/apk-build.log",
  "customizations": {
    "codespaces": {
      "repositories": {
        "Shaya-Ak-7/Pdf-app": {
          "permissions": {
            "contents": "write"
          }
        }
      }
    }
  }
}
